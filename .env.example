# Copia este archivo a .env y completa con tus credenciales de Mercado Pago
# Para modo sandbox usa el Access Token de pruebas desde tu cuenta de Mercado Pago

MP_ACCESS_TOKEN=YOUR_MERCADOPAGO_ACCESS_TOKEN

# Opcionales: URLs de retorno después del pago
BACK_URL_SUCCESS=http://localhost:3000/
BACK_URL_FAILURE=http://localhost:3000/
BACK_URL_PENDING=http://localhost:3000/

# Ruta al archivo PDF que entregarás al comprador (ruta relativa al proyecto)
PDF_PATH=./digital/recetario.pdf

# SMTP (para enviar emails). Puedes usar SendGrid SMTP, Mailgun SMTP o tu servidor SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false # true para 465
SMTP_USER=usuario_smtp
SMTP_PASS=clave_smtp

# Email que recibirá la notificación de venta
SELLER_EMAIL=vendedor@tudominio.com
 
# Opcional: clave secreta para verificar firmas HMAC enviadas por el proveedor de webhooks
# Si tu proveedor incluye un header de firma HMAC (ej. `x-hub-signature-256`), pon acá la clave
MP_WEBHOOK_KEY=

# URL base pública de tu app (usada para construir enlaces de descarga). Ej: https://tu-dominio.com
APP_BASE_URL=http://localhost:3000

# Enlace expirable: duración en minutos (por defecto 1440 = 24h)
LINK_EXPIRATION_MINUTES=1440
