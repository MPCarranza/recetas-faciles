# Mercado Pago: usá primero el Access Token de prueba de tu aplicación.
MP_ACCESS_TOKEN=APP_USR_REEMPLAZAR
MP_ENVIRONMENT=sandbox
MP_WEBHOOK_SECRET=REEMPLAZAR_CON_LA_CLAVE_SECRETA_DEL_WEBHOOK
MP_STATEMENT_DESCRIPTOR=AIRFRYER365

# URL HTTPS pública, sin barra final. En local podés usar la URL de un túnel.
APP_BASE_URL=https://tu-dominio.com
PORT=3000
NODE_ENV=development

# Catálogo controlado por el servidor. Para una cuenta argentina normalmente usá ARS.
PRODUCT_ID=air-fryer-365
PRODUCT_TITLE=Air Fryer 365 Recetas
PRODUCT_DESCRIPTION=Recetario digital en formato PDF
PRODUCT_PRICE=17999
PRODUCT_CURRENCY=ARS

# El archivo debe estar dentro de digital/ y no debe publicarse como archivo estático.
PDF_PATH=digital/recetario.pdf
LINK_EXPIRATION_DAYS=30
# Secreto largo y aleatorio para firmar enlaces. Obligatorio en producción.
DOWNLOAD_TOKEN_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO

# SMTP para enviar el enlace de descarga y el aviso de venta.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASS=clave_smtp
SMTP_FROM=ventas@tu-dominio.com
SELLER_EMAIL=vendedor@tu-dominio.com
# Opcional: destino del botón Responder en los correos al comprador.
SUPPORT_EMAIL=soporte@tu-dominio.com
