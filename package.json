{
  "name": "recetas-faciles",
  "version": "1.0.0",
  "description": "Sitio de venta del recetario Air Fryer 365 Recetas con integración de Mercado Pago",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:email": "node scripts/test-email.js",
