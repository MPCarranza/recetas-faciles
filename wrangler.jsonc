{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recetas-faciles",
  "main": "worker.js",
  "compatibility_date": "2026-09-24",
  "routes": [
    {
      "pattern": "buenasrecetas.com.ar",
      "custom_domain": true
    },
    {
      "pattern": "www.buenasrecetas.com.ar",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buenas-recetas",
      "database_id": "8c1f2c8f-bbc9-41e5-9924-b3eaa6735e02"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECETARIO_BUCKET",
      "bucket_name": "buenas-recetas-private"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "MP_ENVIRONMENT": "sandbox",
    "APP_BASE_URL": "https://buenasrecetas.com.ar",
    "SELLER_EMAIL": "365recetasparavos@gmail.com",
    "SUPPORT_EMAIL": "365recetasparavos@gmail.com",
    "MP_STATEMENT_DESCRIPTOR": "AIRFRYER365",
    "PRODUCT_ID": "air-fryer-365",
    "PRODUCT_TITLE": "Air Fryer 365 Recetas",
    "PRODUCT_DESCRIPTION": "Recetario digital en formato PDF",
    "PRODUCT_PRICE": "17999",
    "PRODUCT_CURRENCY": "ARS",
    "LINK_EXPIRATION_DAYS": "30",
    "PDF_OBJECT_KEY": "recetario.pdf",
    "EMAIL_FROM": "Air Fryer 365 <onboarding@resend.dev>"
  }
}
